WorldInfo {
  info [
    "S4VN spawn lab: world mau de thu keo tha doi tuong / cam bien / banh xe (scripts/webots-spawn-poc)"
    "clawbot_v2: ClawBot V2 (du an ClawBot V2 tren /simulation), controller clawbot_controller, robot window LiemsStudio"
    "Robot tu lap (student_bot) them tu thu vien de gan Than vat ly / Bo banh xe"
    "san: textures/s4vn_floor.png (o 0.5 m), co ca o worlds/textures (Webots) va textures/ (trinh duyet)"
  ]
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material2 "clawbot_wheel"
      coulombFriction [
        8
      ]
      softCFM 1e-05
    }
  ]
}
Viewpoint {
  orientation -0.297 0.297 0.9077 1.667
  position 0 -3 2.2
}
Background {
  skyColor [
    0.78 0.84 0.93
  ]
}
DirectionalLight {
  direction -0.3 0.5 -1
  intensity 1.2
  castShadows TRUE
}
DirectionalLight {
  direction 0.4 -0.6 -0.8
  intensity 0.5
}
RectangleArena {
  floorSize 3 3
  floorTileSize 1 1
  floorAppearance PBRAppearance {
    baseColorMap ImageTexture {
      url [
        "textures/s4vn_floor.png"
      ]
    }
    roughness 1
    metalness 0
  }
  wallHeight 0.3
  wallAppearance PBRAppearance {
    baseColor 0.8 0.83 0.88
    roughness 0.7
    metalness 0
  }
}
